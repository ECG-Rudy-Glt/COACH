# Copy to .env (done by scripts/init-secrets.sh). This file holds NON-secret settings only.
# Secrets live in ./secrets/* (Docker file secrets) — see docs/configuration.md.

# ── Database ────────────────────────────────────────────────────────────
POSTGRES_DB=coach
POSTGRES_USER=coach

# ── Network / HTTPS ─────────────────────────────────────────────────────
APP_BIND=127.0.0.1          # 0.0.0.0 to expose on the LAN (prefer the https profile or your own reverse proxy)
APP_PORT=8000
DOMAIN=localhost            # public host name for the `https` profile (Caddy / Let's Encrypt)
COOKIE_SECURE=0             # set to 1 behind HTTPS (the app also detects X-Forwarded-Proto)
REGISTRATION=open           # open | closed — set to closed once your accounts exist

# ── AI coach (optional) ─────────────────────────────────────────────────
# Provider catalog: data/llm_providers.yaml → anthropic | openai | gemini | mistral | openrouter | ollama | custom | none
LLM_PROVIDER=anthropic
LLM_MODEL=                  # empty = provider default (see GET /llm for suggestions)
LLM_MODEL_FAST=             # cheaper model for short tasks (meal estimation); empty = provider default
LLM_BASE_URL=               # required for `custom`; overrides the provider URL otherwise
LLM_MONTHLY_BUDGET_EUR=5    # hard monthly cap on AI spend; calls are refused beyond it
LLM_PRICE_IN_EUR_PER_MTOK=  # used for the cap; empty = built-in price of the model (3 if unknown, 0 for ollama)
LLM_PRICE_OUT_EUR_PER_MTOK= # empty = built-in price of the model (15 if unknown, 0 for ollama)
LLM_USD_TO_EUR=             # converts the built-in USD prices; empty = 0.90
# The API key goes in ./secrets/llm_api_key (empty file = AI disabled, everything else keeps working).

# ── Wearables ───────────────────────────────────────────────────────────
AUTO_SYNC=1                 # background Garmin sync
GARMIN_SYNC_HOURS=6

# ── Notifications (all optional) ────────────────────────────────────────
AUTO_NOTIFY=0
NOTIFY_HOUR=18
NTFY_URL=                   # ntfy server reachable from the app; token in ./secrets/ntfy_token
NTFY_PUBLIC_URL=            # address to type in the ntfy phone app
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=                  # password in ./secrets/smtp_password
SMTP_FROM=
VAPID_PUBLIC_KEY=           # filled by `scripts/init-secrets.sh --vapid`
VAPID_SUBJECT=mailto:you@example.org

# ── Misc ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
BACKUP_KEEP_DAYS=14
# COACH_IMAGE=ghcr.io/ecg-rudy-glt/coach:latest   # use a published image instead of building
